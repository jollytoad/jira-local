{
  "tasks": {
    "sync": "deno run --allow-net --allow-read --allow-write=.jira --allow-env --env-file src/main.ts",
    "ok": "deno fmt && deno lint && deno check"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "useUnknownInCatchVariables": true,
    "noImplicitOverride": true
  },
  "nodeModulesDir": "none"
}
