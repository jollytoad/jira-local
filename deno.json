{
  "imports": {
    "@std/dotenv": "jsr:@std/dotenv@^0.225.8",
    "@std/front-matter": "jsr:@std/front-matter@^1.0.9",
    "@std/yaml": "jsr:@std/yaml@^1.2.0"
  },
  "lint": {
    "exclude": [".tmp"]
  },
  "fmt": {
    "exclude": [".tmp"]
  },
  "tasks": {
    "sync": "deno run --allow-net --allow-read --allow-write --allow-env --env-file src/main.ts",
    "categorize": "deno run --allow-read --allow-write --allow-env --env-file src/main.ts categorize",
    "ok": "deno fmt && deno lint && deno check",
    "compile": "deno compile --allow-net --allow-read --allow-write --allow-env --output jira-local src/main.ts"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "useUnknownInCatchVariables": true,
    "noImplicitOverride": true
  },
  "nodeModulesDir": "none"
}
