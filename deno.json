{
  "name": "@jollytoad/jira-local",
  "version": "0.3.0",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts",
    "./cli": "./src/cli.ts"
  },
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@^1.3.1",
    "@cliffy/prompt": "jsr:@cliffy/prompt@^1.3.1",
    "@cliffy/upgrade": "jsr:@cliffy/upgrade@^1.3.1",
    "@playwright/test": "npm:@playwright/test@^1.64.1",
    "@std/front-matter": "jsr:@std/front-matter@^1.0.9",
    "@std/fmt": "jsr:@std/fmt@^1.0.10",
    "@std/yaml": "jsr:@std/yaml@^1.3.0",
    "playwright-bdd": "npm:playwright-bdd@^9.2.1",
    "skills": "npm:skills@^1.7.2"
  },
  "exclude": [
    ".tmp",
    ".jira",
    "playwright-bdd-gen/",
    "test-results/",
    "playwright-report/"
  ],
  "lint": {
    "exclude": [".tmp", ".jira"]
  },
  "fmt": {
    "exclude": [".tmp", ".jira"]
  },
  "tasks": {
    "jira-local": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run --env-file src/cli.ts",
    "ok": "deno fmt && deno lint && deno check && deno task publish:check",
    "check:merge": "deno run --allow-read --allow-write --allow-run --allow-env tools/merge-check.ts",
    "check:pull": "deno run --allow-read --allow-write --allow-run --allow-env tools/pull-e2e.ts",
    "check:push": "deno run --allow-net --allow-read --allow-write --allow-run --allow-env tools/push-e2e.ts",
    "check:create": "deno run --allow-net --allow-read --allow-write --allow-run --allow-env tools/create-e2e.ts",
    "check:md": "deno run --allow-read tools/md-roundtrip.ts",
    "test:e2e": {
      "description": "Run the Gherkin suite. Codegen runs first, so an edited .feature is never silently skipped; extra args go to the playwright call, e.g. --list or --ui",
      "command": "deno run -A npm:playwright-bdd && deno run -A npm:@playwright/test test"
    },
    "test:e2e:list": {
      "description": "List the generated scenarios without running them",
      "command": "deno run -A npm:playwright-bdd && deno run -A npm:@playwright/test test --list"
    },
    "version": "deno run --allow-read --allow-write tools/write-version.ts",
    "compile": "deno task version && deno compile -P --app-name jira-local --output jira-local src/cli.ts",
    "publish:check": "deno publish --dry-run --allow-dirty",
    "publish": "deno publish"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "useUnknownInCatchVariables": true,
    "noImplicitOverride": true
  },
  "compile": {
    "permissions": {
      "net": true,
      "read": true,
      "write": true,
      "env": true,
      "run": true
    }
  },
  "nodeModulesDir": "none",
  "publish": {
    "exclude": [
      ".github",
      ".jira",
      ".tmp",
      ".vscode",
      "AGENTS.md",
      "Formula/",
      "playwright-bdd-gen/",
      "playwright-report/",
      "test-results/",
      "tools/"
    ]
  }
}
